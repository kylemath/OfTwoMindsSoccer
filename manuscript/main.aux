\@writefile{lof}{\contentsline {figure}{\numberline {18}{\ignorespaces \textbf  {Head--body dissociation time series} (simulated pipeline demonstration). Head direction angle (blue) and body momentum angle (red) remain coupled during the pre-commitment phase, then diverge sharply after dive commitment onset (green dashed line), consistent with the motor-broadcast prediction (P7). Data are synthetic; real-data application is the immediate next step.}}{28}{figure.caption.24}\protected@file@percent }
\newlabel{fig:video_hbd}{{18}{28}{\textbf {Head--body dissociation time series} (simulated pipeline demonstration). Head direction angle (blue) and body momentum angle (red) remain coupled during the pre-commitment phase, then diverge sharply after dive commitment onset (green dashed line), consistent with the motor-broadcast prediction (P7). Data are synthetic; real-data application is the immediate next step}{figure.caption.24}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {19}{\ignorespaces \textbf  {Pose skeleton overlay} (simulated data). Stick-figure representation of goalkeeper (blue, person 0) and striker (orange, person 1) landmarks extracted by the pose estimation pipeline, shown at a frame shortly after dive commitment. The 33-landmark MediaPipe skeleton provides sufficient anatomical resolution to track head direction (nose--shoulder vector), body momentum (hip displacement), and striker hip rotation. Coordinates are in normalised image space.}}{29}{figure.caption.25}\protected@file@percent }
\newlabel{fig:video_pose}{{19}{29}{\textbf {Pose skeleton overlay} (simulated data). Stick-figure representation of goalkeeper (blue, person 0) and striker (orange, person 1) landmarks extracted by the pose estimation pipeline, shown at a frame shortly after dive commitment. The 33-landmark MediaPipe skeleton provides sufficient anatomical resolution to track head direction (nose--shoulder vector), body momentum (hip displacement), and striker hip rotation. Coordinates are in normalised image space}{figure.caption.25}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {20}{\ignorespaces \textbf  {Pipeline architecture.} Four-stage processing flow from broadcast footage to theory tests. Stage~1 acquires and clips individual penalties; Stage~2 extracts 33-landmark pose trajectories for goalkeeper and striker; Stage~3 computes theory-mapped kinematic features (head--body dissociation, dive commitment onset, postural asymmetry, striker hip rotation); Stage~4 performs statistical tests of Tier~2 predictions.}}{30}{figure.caption.26}\protected@file@percent }
\newlabel{fig:video_pipeline}{{20}{30}{\textbf {Pipeline architecture.} Four-stage processing flow from broadcast footage to theory tests. Stage~1 acquires and clips individual penalties; Stage~2 extracts 33-landmark pose trajectories for goalkeeper and striker; Stage~3 computes theory-mapped kinematic features (head--body dissociation, dive commitment onset, postural asymmetry, striker hip rotation); Stage~4 performs statistical tests of Tier~2 predictions}{figure.caption.26}{}}
