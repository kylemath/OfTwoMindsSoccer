\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces \textbf  {Prediction 2: sequential effects.} \textbf  {A.} Bundesliga: goals are significantly more likely after a previous goal than after a non-goal ($p = 0.0048$). Error bars show 95\% Wilson CIs. \textbf  {B.} Multi-league data: goalkeepers repeated their dive direction $75.0\%$ of the time across consecutive same-goalkeeper penalties ($p = 0.0008$).}}{14}{figure.caption.11}\protected@file@percent }
\newlabel{fig:emp_pred2}{{8}{14}{\textbf {Prediction 2: sequential effects.} \textbf {A.} Bundesliga: goals are significantly more likely after a previous goal than after a non-goal ($p = \PredTwoChiP $). Error bars show 95\% Wilson CIs. \textbf {B.} Multi-league data: goalkeepers repeated their dive direction $\PredTwoKaggleRepeatRate $ of the time across consecutive same-goalkeeper penalties ($p = \PredTwoKaggleBinomP $)}{figure.caption.11}{}}
\citation{tafazoli2026compositional}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces \textbf  {Time-decay and team-level dissociation of the sequential effect.} Each row shows tertile-binned bars (left) and a 5-minute sliding window (right) for a different subset of consecutive in-game penalties. \textbf  {A--B.}~All consecutive pairs ($n = 622$): conversion after a previous non-goal drops sharply in the 13--32~min interval. \textbf  {C--D.}~Same team shoots again ($n = 236$; same goalkeeper faces both kicks): the goalkeeper's ``save momentum'' is strongest at 17--36~min, where post-non-goal conversion craters to ${\sim }44\%$ before recovering---implying that the goalkeeper's effective save rate approximately doubles relative to baseline in this window. \textbf  {E--F.}~Opposing team shoots next ($n = 386$; different goalkeeper): at longer intervals (30+ min), miss contagion emerges---conversion drops after the \emph  {opposing} team failed, a pattern inconsistent with independence, momentum decay, or motivational accounts. Error bars and shaded bands show 95\% Wilson CIs.}}{16}{figure.caption.12}\protected@file@percent }
\newlabel{fig:emp_pred2_decay}{{9}{16}{\textbf {Time-decay and team-level dissociation of the sequential effect.} Each row shows tertile-binned bars (left) and a 5-minute sliding window (right) for a different subset of consecutive in-game penalties. \textbf {A--B.}~All consecutive pairs ($n = 622$): conversion after a previous non-goal drops sharply in the 13--32~min interval. \textbf {C--D.}~Same team shoots again ($n = 236$; same goalkeeper faces both kicks): the goalkeeper's ``save momentum'' is strongest at 17--36~min, where post-non-goal conversion craters to ${\sim }44\%$ before recovering---implying that the goalkeeper's effective save rate approximately doubles relative to baseline in this window. \textbf {E--F.}~Opposing team shoots next ($n = 386$; different goalkeeper): at longer intervals (30+ min), miss contagion emerges---conversion drops after the \emph {opposing} team failed, a pattern inconsistent with independence, momentum decay, or motivational accounts. Error bars and shaded bands show 95\% Wilson CIs}{figure.caption.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces \textbf  {Shootout replication.} FIFA World Cup shootouts (1982--2022) show a directionally consistent but non-significant sequential effect. The alternating-team structure of shootouts makes this a particularly demanding test of the task-history ghost hypothesis.}}{17}{figure.caption.13}\protected@file@percent }
\newlabel{fig:emp_pred2_shootout}{{10}{17}{\textbf {Shootout replication.} FIFA World Cup shootouts (1982--2022) show a directionally consistent but non-significant sequential effect. The alternating-team structure of shootouts makes this a particularly demanding test of the task-history ghost hypothesis}{figure.caption.13}{}}
\citation{jordet2009superstars}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces \textbf  {Cross-dataset robustness.} The sequential effect examined across all three datasets, each shown as tertile-binned bars (left) and a continuous time/round plot (right). \textbf  {A--B.}~Bundesliga in-game penalties (1963--2017; $n = 622$ pairs): the strongest effect, with a pronounced mid-interval dip in conversion after previous non-goals. \textbf  {C--D.}~Multi-league in-game penalties (2020--2025; $n = 341$ same-goalkeeper pairs): no significant sequential effect, but inter-penalty intervals are shorter (median 8~min), falling in the range where the Bundesliga data also shows minimal separation. \textbf  {E--F.}~FIFA World Cup shootouts (1982--2022; $n = 353$ consecutive kicks): the effect is directionally consistent across all kick-position bins, with red (prev = goal) above blue (prev = non-goal) throughout.}}{18}{figure.caption.14}\protected@file@percent }
\newlabel{fig:emp_pred2_cross}{{11}{18}{\textbf {Cross-dataset robustness.} The sequential effect examined across all three datasets, each shown as tertile-binned bars (left) and a continuous time/round plot (right). \textbf {A--B.}~Bundesliga in-game penalties (1963--2017; $n = 622$ pairs): the strongest effect, with a pronounced mid-interval dip in conversion after previous non-goals. \textbf {C--D.}~Multi-league in-game penalties (2020--2025; $n = 341$ same-goalkeeper pairs): no significant sequential effect, but inter-penalty intervals are shorter (median 8~min), falling in the range where the Bundesliga data also shows minimal separation. \textbf {E--F.}~FIFA World Cup shootouts (1982--2022; $n = 353$ consecutive kicks): the effect is directionally consistent across all kick-position bins, with red (prev = goal) above blue (prev = non-goal) throughout}{figure.caption.14}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.4}Prediction 4: Expertise Blind Spots}{19}{subsection.4.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces \textbf  {Prediction 4: expertise and save rate.} Logistic regression of save rate on goalkeeper experience (seasons). A non-significant quadratic trend peaks at $\sim $$$ seasons, suggestive of but insufficient to confirm the expertise-blind-spot hypothesis.}}{19}{figure.caption.15}\protected@file@percent }
\newlabel{fig:emp_pred4}{{12}{19}{\textbf {Prediction 4: expertise and save rate.} Logistic regression of save rate on goalkeeper experience (seasons). A non-significant quadratic trend peaks at $\sim $$\PredFourPeakExp $ seasons, suggestive of but insufficient to confirm the expertise-blind-spot hypothesis}{figure.caption.15}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces \textbf  {Prediction 4: save rate by experience bin.} Goalkeeper save rate for ``readable'' penalties (goals and saves only, excluding post, bar, and off-target misses) grouped by career experience in Bundesliga seasons. The absence of a monotonic increase with experience is consistent with---though not diagnostic of---the gain-modulation blind-spot hypothesis: expertise-driven amplification of reliable cues may be offset by suppression of informative secondary cues.}}{20}{figure.caption.16}\protected@file@percent }
\newlabel{fig:emp_pred4_bins}{{13}{20}{\textbf {Prediction 4: save rate by experience bin.} Goalkeeper save rate for ``readable'' penalties (goals and saves only, excluding post, bar, and off-target misses) grouped by career experience in Bundesliga seasons. The absence of a monotonic increase with experience is consistent with---though not diagnostic of---the gain-modulation blind-spot hypothesis: expertise-driven amplification of reliable cues may be offset by suppression of informative secondary cues}{figure.caption.16}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.5}Prediction 5: Keeper Centrality}{20}{subsection.4.5}\protected@file@percent }
\citation{bareli2007action}
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces \textbf  {Prediction 5: keeper centrality.} No difference in conversion rate between central and diving goalkeepers, but the central condition has only $n = $ cases.}}{21}{figure.caption.17}\protected@file@percent }
\newlabel{fig:emp_pred5}{{14}{21}{\textbf {Prediction 5: keeper centrality.} No difference in conversion rate between central and diving goalkeepers, but the central condition has only $n = \PredFiveNCentral $ cases}{figure.caption.17}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces \textbf  {Prediction 5: supplementary analysis.} \textbf  {Left:} Distribution of kicker shot directions against central goalkeepers---kickers predominantly target the sides. \textbf  {Right:} Conversion rate by kicker direction when the goalkeeper dives, showing high conversion regardless of shot placement. Together, these panels illustrate that central keepers force lateral commitment while diving keepers cede near-certain goals when they guess wrong.}}{22}{figure.caption.18}\protected@file@percent }
\newlabel{fig:emp_pred5_supp}{{15}{22}{\textbf {Prediction 5: supplementary analysis.} \textbf {Left:} Distribution of kicker shot directions against central goalkeepers---kickers predominantly target the sides. \textbf {Right:} Conversion rate by kicker direction when the goalkeeper dives, showing high conversion regardless of shot placement. Together, these panels illustrate that central keepers force lateral commitment while diving keepers cede near-certain goals when they guess wrong}{figure.caption.18}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.6}Prediction 6: Pre-Commitment (Foot Congruence)}{22}{subsection.4.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces \textbf  {Prediction 6: foot congruence as pre-commitment proxy.} No significant difference between natural-side and unnatural-side kicks. The dominant predictor of conversion is whether the goalkeeper dived the correct way.}}{23}{figure.caption.19}\protected@file@percent }
\newlabel{fig:emp_pred6}{{16}{23}{\textbf {Prediction 6: foot congruence as pre-commitment proxy.} No significant difference between natural-side and unnatural-side kicks. The dominant predictor of conversion is whether the goalkeeper dived the correct way}{figure.caption.19}{}}
\citation{tafazoli2026compositional}
\@writefile{lof}{\contentsline {figure}{\numberline {17}{\ignorespaces \textbf  {Prediction 6: congruence $\times $ goalkeeper accuracy interaction.} Conversion rates for natural (cross-body) and unnatural (same-side) shots, split by whether the goalkeeper dived the correct direction. When the keeper is wrong, conversion is near-ceiling regardless of congruence. When the keeper is correct, a descriptive (non-significant) pattern emerges: natural shots may be slightly easier to save, consistent with the hypothesis that pre-committed motor programmes produce more predictable kinematics.}}{24}{figure.caption.20}\protected@file@percent }
\newlabel{fig:emp_pred6_interact}{{17}{24}{\textbf {Prediction 6: congruence $\times $ goalkeeper accuracy interaction.} Conversion rates for natural (cross-body) and unnatural (same-side) shots, split by whether the goalkeeper dived the correct direction. When the keeper is wrong, conversion is near-ceiling regardless of congruence. When the keeper is correct, a descriptive (non-significant) pattern emerges: natural shots may be slightly easier to save, consistent with the hypothesis that pre-committed motor programmes produce more predictable kinematics}{figure.caption.20}{}}
