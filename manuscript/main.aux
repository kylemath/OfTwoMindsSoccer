\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}Prediction 1: Within- vs.\ Cross-Axis Interference}{11}{subsection.4.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {Prediction 1: conversion rate by mismatch type.} Both within-axis and cross-axis mismatches produce near-ceiling conversion rates ($>95\%$), vastly exceeding the match condition. The prediction of differential interference between mismatch types is not supported.}}{12}{figure.caption.9}\protected@file@percent }
\newlabel{fig:emp_pred1}{{6}{12}{\textbf {Prediction 1: conversion rate by mismatch type.} Both within-axis and cross-axis mismatches produce near-ceiling conversion rates ($>95\%$), vastly exceeding the match condition. The prediction of differential interference between mismatch types is not supported}{figure.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \textbf  {Prediction 1: decision matrix.} Heatmap of conversion rate by kicker shot direction (rows) and goalkeeper dive direction (columns). Off-diagonal cells show near-ceiling conversion ($>$95\%), while the diagonal (direction match) yields substantially lower conversion. Cell annotations show the conversion rate and sample size. The uniformly high off-diagonal rates illustrate the floor effect that prevents detection of differential within-axis vs.\ cross-axis interference in binary outcome data.}}{13}{figure.caption.10}\protected@file@percent }
\newlabel{fig:emp_pred1_heatmap}{{7}{13}{\textbf {Prediction 1: decision matrix.} Heatmap of conversion rate by kicker shot direction (rows) and goalkeeper dive direction (columns). Off-diagonal cells show near-ceiling conversion ($>$95\%), while the diagonal (direction match) yields substantially lower conversion. Cell annotations show the conversion rate and sample size. The uniformly high off-diagonal rates illustrate the floor effect that prevents detection of differential within-axis vs.\ cross-axis interference in binary outcome data}{figure.caption.10}{}}
